{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "云枢AI一键写入U盘",
  "version": "0.1.0",
  "identifier": "com.yunshu.usb-installer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1421",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "云枢AI一键写入U盘",
        "width": 860,
        "height": 660,
        "minWidth": 760,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
