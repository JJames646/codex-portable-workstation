{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "云枢AI便携工作站",
  "version": "0.1.0",
  "identifier": "studio.yunshu.three-engine-workstation",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5174",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "云枢AI便携工作站",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false
  }
}
